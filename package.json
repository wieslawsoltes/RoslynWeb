{
  "name": "@roslynweb/core",
  "version": "0.7.0",
  "type": "module",
  "description": "Roslyn C# compilation in WebAssembly, direct MSIL-to-WebAssembly compilation and managed assembly execution",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./il": {
      "types": "./src/il/index.d.ts",
      "import": "./src/il/index.js"
    },
    "./packages": {
      "types": "./src/packages/index.d.ts",
      "import": "./src/packages/index.js"
    },
    "./projects": {
      "types": "./src/projects/index.d.ts",
      "import": "./src/projects/index.js"
    },
    "./hosting": {
      "types": "./src/hosting/index.d.ts",
      "import": "./src/hosting/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    },
    "./wasm": {
      "types": "./src/wasm/index.d.ts",
      "import": "./src/wasm/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "demo",
    "docs",
    "managed",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses",
    "global.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:compat": "node scripts/test-compat.mjs",
    "pages:build": "node scripts/stage-pages.mjs",
    "test:build": "node scripts/test-build.mjs",
    "test:projects-wasm": "node tests/projects-wasm.mjs",
    "test:v4": "node scripts/test-v4.mjs",
    "test:files": "node managed/runtime-files-tests.mjs",
    "test:desktop": "node tests/desktop/wasm.mjs",
    "test:performance": "node managed/runtime-performance-tests.mjs",
    "benchmark:wasm": "node scripts/benchmark-wasm.mjs",
    "test:wasm-native": "node tests/wasm-native-integration.mjs",
    "test:compilers": "node tests/compiler-v6-integration.mjs",
    "benchmark:compilers": "node scripts/benchmark-compilers.mjs",
    "test:compilers-v7": "node tests/compiler-v7-integration.mjs",
    "benchmark:compilers-v7": "node scripts/benchmark-compilers-v7.mjs",
    "benchmark:host-cache": "node scripts/benchmark-host-cache.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wieslawsoltes/RoslynWeb.git"
  },
  "homepage": "https://wieslawsoltes.github.io/RoslynWeb/"
}
