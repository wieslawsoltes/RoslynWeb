<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ReferenceAssembliesPath Condition="'$(ReferenceAssembliesPath)' == ''">$(MSBuildSDKsPath)/../../../packs/Microsoft.NETCore.App.Ref/10.0.0/ref/net10.0</ReferenceAssembliesPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CompilerExtensionFixture.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="BuildTaskFixture.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../CompilerExtensions.cs" Link="CompilerExtensions.cs" />
    <Compile Include="../ObjectBridge.cs" Link="ObjectBridge.cs" />
    <Compile Include="../BuildTaskBridge.cs" Link="BuildTaskBridge.cs" />
    <Compile Include="../Resources.cs" Link="Resources.cs" />
    <Compile Include="../ExecutionFiles.cs" Link="ExecutionFiles.cs" />
    <Compile Include="../CompilerBridge.cs" Link="CompilerBridge.cs" />
    <Compile Include="../IlInspector.cs" Link="IlInspector.cs" />
    <Compile Include="../IntegerJsonConverters.cs" Link="IntegerJsonConverters.cs" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Reference Include="Microsoft.Build.Framework"><HintPath>$(MSBuildSDKsPath)/../Microsoft.Build.Framework.dll</HintPath></Reference>
    <Reference Include="Microsoft.Build.Utilities.Core"><HintPath>$(MSBuildSDKsPath)/../Microsoft.Build.Utilities.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.NET.StringTools"><HintPath>$(MSBuildSDKsPath)/../Microsoft.NET.StringTools.dll</HintPath></Reference>
    <EmbeddedResource Include="$(MSBuildSDKsPath)/../Microsoft.Build.Framework.dll;$(MSBuildSDKsPath)/../Microsoft.Build.Utilities.Core.dll" LogicalName="ReferenceAssemblies/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll;$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" LogicalName="ReferenceAssemblies/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(ReferenceAssembliesPath)/*.dll" LogicalName="ReferenceAssemblies/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
